{
  "name": "flow-local-test-runner",
  "version": "4.0.0",
  "description": "Persistent adaptive local toggle for Google Flow frontend response override",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:patch": "node --test tests/patch.test.js",
    "test:security": "node --test tests/security.test.js",
    "test:metrics": "node --test tests/metrics.test.js",
    "test:config": "node --test tests/config.test.js",
    "lint": "node scripts/check-syntax.js",
    "validate": "node scripts/validate-manifest.js",
    "check": "npm run lint && npm run validate && npm test"
  },
  "keywords": [
    "chrome-extension",
    "flow",
    "testing",
    "debugging"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
